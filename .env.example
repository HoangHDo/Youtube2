# ---------------------------------------------------------------------------
# CyberStream configuration. Copy to `.env` (it is git-ignored).
# Every value below is optional; defaults are shown.
# ---------------------------------------------------------------------------

# --- server ----------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
# Set when running behind a reverse proxy that terminates TLS.
# PUBLIC_ORIGIN=https://stream.example.com
# Comma-separated list of origins allowed to call the API (CSRF protection).
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# --- security --------------------------------------------------------------
# If set, every stream endpoint (?token=) must present this value too.
# NOTE: this is NOT authentication. Put a real auth layer in front of the app
# (see Caddyfile for a basic-auth example). The per-session viewer token is
# always generated by the server and is the primary access control.
# STREAM_TOKEN=change-me
# Serve the viewer token to same-origin pages (default true). Set false if you
# inject the token yourself (reverse proxy auth, SSR page, ...).
ALLOW_CLIENT_TOKEN_BOOTSTRAP=true
# Bodies larger than this are rejected.
MAX_JSON_BODY=8kb
# How many seconds a browser token stays valid once minted.
VIEWER_TOKEN_TTL=900

# --- sessions / limits -----------------------------------------------------
# Hard cap on a single stream's wall-clock lifetime; FFmpeg exits on its own.
MAX_SESSION_MS=7200000
# Grace period after the last viewer disconnects before FFmpeg is killed.
ORPHAN_GRACE_MS=30000
# A session with no client that never attached is considered failed.
BOOT_TIMEOUT_MS=20000
# Server-side reaper interval.
CLEANUP_INTERVAL_MS=15000
# How many concurrent sessions this process will host.
MAX_SESSIONS=32
# Per-IP session creation limit.
RATE_LIMIT_CREATE_PER_MIN=10
RATE_LIMIT_GLOBAL_PER_MIN=600
# Disk space guard for temp dirs.
MAX_TEMP_BYTES=536870912

# --- ffmpeg ----------------------------------------------------------------
FFMPEG_PATH=ffmpeg
# Output resolution. JSMpeg decodes MPEG-1 in JavaScript, so this is the single
# biggest lever on whether playback looks smooth.
VIDEO_WIDTH=960
VIDEO_HEIGHT=540
# Fixed output frame rate, snapped to a legal MPEG-1 rate (24/25/30/50/60).
VIDEO_FPS=25
# mpeg1video quantiser: 1 = best quality (and ~6 Mbit/s), 31 = smallest.
# 12 lands near 1 Mbit/s at 540p, which decodes comfortably in a browser.
VIDEO_Q=12
# Keyframe interval in frames. 12 @25fps = a keyframe every 0.48s, which bounds
# how long JSMpeg needs to resync after a dropped chunk.
GOP=12
# MPEG-TS mux delay in seconds. Lower = lower latency.
MUX_DELAY=0.1
AUDIO_BITRATE=128k
AUDIO_SAMPLE_RATE=44100
AUDIO_CHANNELS=2
# Threads per FFmpeg process. 0 = auto.
FFMPEG_THREADS=0
# Parse PTS out of the MPEG-TS stream to drive A/V drift correction.
TS_CLOCK_ENABLED=true
# max_muxing_queue_size
MAX_MUXING_QUEUE=1024
# Incoming network timeout / reconnect behaviour for remote inputs.
RW_TIMEOUT_US=20000000

# --- youtube resolution ----------------------------------------------------
# yt-dlp is used to turn a YouTube URL/ID into a direct media URL.
# Put the binary in ./bin (npm run tools) or point at a system install.
YT_DLP_PATH=yt-dlp
# extra args appended to every yt-dlp call
YT_DLP_EXTRA_ARGS=
# Optional: force specific YouTube "webpage" clients (comma separated).
# LEAVE EMPTY to let yt-dlp pick, which is the most future-proof option - the
# client landscape changes often, and pinning `web` alone currently yields
# storyboards only. Use "ios" or "tv" if a video is geo-blocked for the default.
YT_DLP_CLIENTS=
# Force a specific height (best|worst|1080|720...). Empty = best available.
YT_DLP_FORMAT=
# How long the resolved URL is reused before re-resolving (ms).
RESOLVE_TTL_MS=900000
# Reject sources longer than this (0 = unlimited). Live streams ignored.
MAX_SOURCE_DURATION=0
# Allow plain http(s) media URLs (not just YouTube). Off = YouTube only.
ALLOW_DIRECT_MEDIA_URLS=false

# --- logging ---------------------------------------------------------------
LOG_LEVEL=info
LOG_PRETTY=true
