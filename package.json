{
  "name": "cyberstream",
  "version": "1.0.0",
  "private": true,
  "description": "Low-latency YouTube -> browser streamer: FFmpeg MPEG-TS over WebSocket to JSMpeg + MP3 over HTTP to an <audio> element.",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test --test-reporter=spec \"test/**/*.test.js\"",
    "smoke": "node --env-file-if-exists=.env scripts/smoke-ffmpeg.mjs",
    "vendor": "node scripts/vendor.mjs",
    "tools": "node scripts/install-tools.mjs",
    "tools:check": "node scripts/install-tools.mjs --check",
    "catalog:verify": "node --env-file-if-exists=.env scripts/verify-catalog.mjs",
    "postinstall": "node scripts/vendor.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pino": "^10.3.1",
    "socket.io": "^4.8.4",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.2",
    "supertest": "^7.1.4"
  }
}
